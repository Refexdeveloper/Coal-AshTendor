# Backend connection for the React client.

# Development: leave VITE_API_URL empty. Vite proxies /api to API_PROXY_TARGET, so the browser
# sees one origin and the session cookie just works.
API_PROXY_TARGET=http://localhost:4000

# Backend on a different host (separate deployment): set its address here, and add this app's
# address to CLIENT_ORIGIN in server/.env. Rebuild the client after changing it.
VITE_API_URL=

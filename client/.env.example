# Leave empty / omit when the API serves the built UI on one port (same-origin /api).
# Do not bake a LAN IP or production domain into the client build.
# VITE_API_URL=https://tenders.example.com
#
# Local Vite only (proxy target port for `npm run dev`):
VITE_API_PORT=4000
API_PROXY_TARGET=http://localhost:4000

# MySQL 8.0.13 or newer. mysql://USER:PASSWORD@HOST:PORT/DATABASE (the database is created by npm run db:setup).
DATABASE_URL="mysql://root:password@localhost:3306/coal_ash"
SESSION_SECRET="replace-with-a-long-random-string"
# Where people open the app. In development that is the Vite client.
APP_URL="http://localhost:5173"
# Port of this API server. The client dev server proxies /api here.
PORT="4000"
# Only when the React client is hosted on a different address than this API (separate deployment):
# its origin(s), comma separated, e.g. CLIENT_ORIGIN="https://tenders.example.com". Needs HTTPS.
# Leave empty in development: the Vite proxy makes client and API one origin.
CLIENT_ORIGIN=""

# Unfyd Prism OCR. The service downloads Documents[] from a public URL, so OCR_PUBLIC_BASE_URL
# must be an address it can reach (not localhost); point the tunnel at this server's PORT. Each upload is posted as:
# { BotId, InteractionId, DocumentType: "Tendor OCR", Documents: ["<public file url>"] }
OCR_EXTRACT_URL="https://refex-uat.unfyd.com/unfyd-prism/api/admin/ExtractData"
OCR_BOT_ID="I7DI-1NLS-XWPK-9OLX"
OCR_DOCUMENT_TYPE="Tendor OCR"
# OCR_PUBLIC_BASE_URL="https://your-public-host"
DEMO_LOGIN_HINT="true"

# Optional. Until SMTP_HOST, SMTP_USER and SMTP_PASS are all set, messages are only stored in the notification log.
# For Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_PASS = a Google App Password.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Coal & Ash Tenders <tenders@example.com>"
# Testing only: send every notice to one inbox, labelled with the intended recipient.
# MAIL_REDIRECT_TO=

# =============================================================================
# Coal & Ash tender management — server env
# Copy to server/.env and set your port, public domain, and DB credentials.
# Never commit server/.env. Full GCP list: see ../GCP_HOSTING.md
# =============================================================================

# --- Server listen (pick a free port on the host / in Docker) ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# The built client is served from server/public on the same PORT.
# Build first:  npm run build
# (from the repo root)

# --- Public origin (no hardcoded LAN IPs) ---
# Set to the URL users open after you map domain → this service in the proxy.
# Examples:
#   https://tenders.refex.group
#   http://localhost:4000          (local smoke test)
# Public HTTPS URL users open in the browser (NO container port — proxy uses 443).
FRONTEND_URL=http://localhost:4000
PUBLIC_APP_URL=http://localhost:4000
# Email links and the OCR public base fall back to this when APP_URL is unset.
APP_URL=http://localhost:4000
# CORS allow-list (comma-separated). Leave empty when the UI and API share one origin.
CLIENT_ORIGIN=

# --- Database (local MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=coal_ash
DB_USER=coal_ash
DB_PASSWORD=coal_ash_change_me
# Optional. When set, this wins over DB_* for TCP connections.
# DATABASE_URL=mysql://coal_ash:coal_ash_change_me@127.0.0.1:3306/coal_ash

# --- Cloud SQL on Cloud Run (use instead of DB_HOST when deploying) ---
# INSTANCE_CONNECTION_NAME=master-diorama-489103-u2:asia-south1:coal-ash-mysql
# DB_SOCKET_PATH=/cloudsql/master-diorama-489103-u2:asia-south1:coal-ash-mysql

# First boot creates schema (+ seeds when User is empty). Set false to skip.
AUTO_DB_SETUP=true
AUTO_DB_SEED=true

# --- Document storage: local disk (dev) or GCS (Cloud Run) ---
STORAGE_BACKEND=local
# STORAGE_BACKEND=gcs
# GCS_BUCKET=coal-ash-docs-master-diorama-489103-u2
# GCS_PREFIX=coal-ash-docs/

# --- Auth ---
SESSION_SECRET=change_this_to_a_long_random_string

# Sign-in page lists the team only when this is true. Password sign-in is /login?admin=1.
# Other visits use Refex One. These addresses are what you register with Refex One:
#   https://<this-host>/auth/refexone/saml
#   https://<this-host>/api/auth/refexone/saml/acs
#   https://<this-host>/auth/refexone/launch
DEMO_LOGIN_HINT=true
# Refex One sign-in, as in the P2P app. Create a SAML app for Coal & Ash in Refex One (Administration
# here lists the Entity ID, ACS and launch addresses to enter), then set its App ID and Refex One's
# signing certificate. The certificate is required: every sign-in response is checked against it.
# REFEXONE_SAML_APP_ID=          # gives https://refexone.com/api/saml/<id>/sso
# REFEXONE_SSO_URL=              # or the full sign-in URL instead of the App ID
# REFEXONE_IDP_CERT=             # PEM, or one line with \n between lines
# REFEXONE_IDP_CERT_FILE=        # or a path to the PEM file
# REFEXONE_IDP_ISSUER=           # optional: Refex One's issuer/entity ID, checked when set
# Force the public origin when the request host is not the registered one.
# REFEXONE_BASE_URL=https://coal-ash-tender-api-645830234926.asia-south1.run.app

# --- OCR (Unfyd Prism) ---
# The service downloads Documents[] from a public URL, so OCR_PUBLIC_BASE_URL
# must be an address it can reach (not localhost); point the tunnel at this server's PORT.
OCR_EXTRACT_URL=https://refex-live.unfyd.com/unfyd-prism/api/admin/ExtractData
OCR_BOT_ID=I7DI-1NLS-XWPK-9OLX
OCR_DOCUMENT_TYPE=Tendor
# Raw OCR JSON is emailed here after each extraction.
OCR_RESULT_EMAIL=sathishkumar.r@refex.co.in
# OCR_PUBLIC_BASE_URL=https://your-public-host

# --- Email ---
# Until SMTP_HOST, SMTP_USER and SMTP_PASS are all set, notices are only stored in Notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Coal & Ash Tenders <tenders@example.com>
# Testing only: send every notice to one inbox, labelled with the intended recipient.
# MAIL_REDIRECT_TO=
# Every workflow step (upload, extraction, reviews, approvals, EMD, bid, outcome) is also mailed here.
# MAIL_STEP_COPY_TO=you@example.com

# Refex One user directory sync (Administration → Refex One users → Sync).
# The org-admin token is set in the server, not in this file.
# REFEXONE_API_URL=https://refexone.com/api
# Hours between automatic syncs (default 24). 0 turns the daily sync off; the admin button still works.
# REFEXONE_SYNC_HOURS=24

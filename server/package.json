{
  "name": "coal-ash-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "tsx scripts/check-domain.ts",
    "db:generate": "prisma generate",
    "db:setup": "prisma generate && tsx scripts/db-setup.ts && tsx prisma/seed.ts",
    "db:reset": "prisma generate && tsx scripts/db-setup.ts --reset && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.1",
    "nodemailer": "^7.0.9",
    "pdf-lib": "^1.17.1",
    "unpdf": "^1.3.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.6.0",
    "@types/nodemailer": "^7.0.1",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
